[Unit]
Description=Scry Agent Service
After=network-online.target postgresql.service scry-query.service
Wants=network-online.target

[Service]
Type=simple
User=scry
Group=scry
EnvironmentFile=/etc/scry.env
WorkingDirectory=/opt/scry/agent
ExecStart=/opt/scry/node/bin/node /opt/scry/agent/dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scry/agent
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

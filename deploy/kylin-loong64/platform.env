SCRY_INSTALL_ROOT=/opt/scry
SCRY_DATA_ROOT=/var/lib/scry
SCRY_AGENT_PORT=4111
SCRY_AGENT_HOST=127.0.0.1
SCRY_AGENT_DATABASE_URL=file:/var/lib/scry/agent/agent.db
SCRY_AGENT_POSTGRES_URL=postgresql://scry_agent:CHANGE_ME@127.0.0.1:5432/scry_agent
SCRY_AGENT_MASTER_KEY=CHANGE_ME_32_BYTES_OR_LONGER
SCRY_JWT_SECRET=CHANGE_ME_32_BYTES_OR_LONGER
SCRY_QUERY_SERVICE_URL=http://127.0.0.1:8080
SCRY_MCP_INTERNAL_URL=http://127.0.0.1:4111/mcp
SCRY_MCP_TIMEOUT_MS=30000
ClickHouseUrl=tcp://127.0.0.1:9000
ALERTMANAGER_API_PREFIX=http://127.0.0.1:9093/api/
SCRY_LOCAL_DB_PATH=/var/lib/scry/query/scry.db
STORAGE=clickhouse
TELEMETRY_ENABLED=false
OSS_TELEMETRY_ENABLED=false
DEPLOYMENT_TYPE=kylin-loong64-native
DASHBOARDS_PATH=/opt/scry/dashboards
INVITE_EMAIL_TEMPLATE=/opt/scry/templates/invitation_email_template.html
GODEBUG=netdns=go
SCRY_DEBUG_MODE_AVAILABLE=false

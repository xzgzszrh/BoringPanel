# Scry source-development Compose settings.
COMPOSE_PROJECT_NAME=scry-dev

FRONTEND_PORT=3301
BACKEND_PORT=8080
BACKEND_INTERNAL_PORT=8085
AGENT_PORT=4111
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
ALERTMANAGER_PORT=9093
SCRY_POSTGRES_PASSWORD=scry_agent

# Scry debug-data worker. Disable this outside development environments.
SCRY_DEBUG_MODE_AVAILABLE=true
SCRY_DEBUG_OTLP_ENDPOINT=http://otel-collector:4318

# Dependency versions are pinned for reproducible local development.
GO_IMAGE=golang:1.22.7-bookworm
NODE_IMAGE=node:20-bookworm
AGENT_IMAGE=scry-agent-service:dev
POSTGRES_IMAGE=postgres:16-bookworm
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.1.2-alpine
# The original bitnami/zookeeper:3.7.1 tag was moved to Bitnami's legacy namespace.
ZOOKEEPER_IMAGE=bitnamilegacy/zookeeper:3.7.1
ALERTMANAGER_IMAGE=signoz/alertmanager:0.23.7
SCHEMA_MIGRATOR_IMAGE=signoz/signoz-schema-migrator:0.111.16
OTEL_COLLECTOR_IMAGE=signoz/signoz-otel-collector:0.111.16

# Optional container egress proxy. Leave blank when Docker has direct access.
DEV_HTTP_PROXY=
DEV_HTTPS_PROXY=
DEV_NO_PROXY=localhost,127.0.0.1,clickhouse,zookeeper-1,query-service,agent-service,alertmanager,otel-collector

# Generate a random value for local use. Never commit the real value.
SCRY_AGENT_MASTER_KEY=
SCRY_JWT_SECRET=scry-development-jwt-secret
